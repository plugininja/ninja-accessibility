{
    "name": "ninja-accessibility",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "WordPress accessibility plugin \u2014 Ninja Accessibility",
    "files": [
        "app",
        "assets",
        "core",
        "includes",
        "languages",
        "templates",
        "index.php",
        "ninja-accessibility.php",
        "readme.txt",
        "uninstall.php"
    ],
    "scripts": {
        "dev-admin": "webpack serve --config webpack.dev.config.js",
        "build-admin": "webpack --config webpack.prod.config.js",
        "watch-assets": "npm run build:tokens && wp-scripts start --config webpack.dev.config.js",
        "watch-sass": "npm run build:tokens && sass --watch source/assets/sass:assets/css --style=expanded --load-path=node_modules",
        "build-sass": "npm run build:tokens && sass source/assets/sass:assets/css --style=compressed --no-source-map --load-path=node_modules --silence-deprecation=import",
        "build-postcss": "postcss \"assets/css/*.css\" \"assets/css/**/*.css\" --replace --no-map",
        "start": "concurrently \"npm:watch-sass\" \"npm:watch-assets\"",
        "dev-hot": "concurrently \"npm:watch-sass\" \"npm:dev-admin\"",
        "clean-maps": "find . \\( -name \"*.map\" -o -name \".DS_Store\" \\) -type f -delete",
        "build": "npm run build-sass && npm run build-postcss && npm run build-admin && npm run clean-maps",
        "lint": "eslint source/ --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint source/ --ext .js,.jsx,.ts,.tsx --fix",
        "make-pot": "wp i18n make-pot . languages/ninja-accessibility.pot --domain=ninja-accessibility --slug=ninja-accessibility --package-name=\"Ninja Accessibility\" --exclude=assets,freemius,node_modules,dist-free --headers='{\"Report-Msgid-Bugs-To\":\"https://wordpress.org/support/plugin/ninja-accessibility\"}'",
        "strip-premium": "node scripts/strip-premium.js --mode=github",
        "strip-premium:wporg": "node scripts/strip-premium.js --mode=wporg",
        "zip:free": "node scripts/zip-free.js",
        "zip:wporg": "node scripts/zip-wporg.js",
        "clean-dist:free": "node scripts/clean-dist.js --mode=github",
        "clean-dist:wporg": "node scripts/clean-dist.js --mode=wporg",
        "make-pot:free": "wp i18n make-pot dist-free dist-free/languages/ninja-accessibility.pot --domain=ninja-accessibility --slug=ninja-accessibility --package-name=\"Ninja Accessibility\" --exclude=assets --headers='{\"Report-Msgid-Bugs-To\":\"https://wordpress.org/support/plugin/ninja-accessibility\"}'",
        "make-pot:wporg": "wp i18n make-pot dist-wporg dist-wporg/languages/ninja-accessibility.pot --domain=ninja-accessibility --slug=ninja-accessibility --package-name=\"Ninja Accessibility\" --exclude=assets --headers='{\"Report-Msgid-Bugs-To\":\"https://wordpress.org/support/plugin/ninja-accessibility\"}'",
        "free": "npm run build && npm run strip-premium && npm --prefix dist-free run build-admin && npm run make-pot:free && npm run clean-dist:free && npm run zip:free",
        "wporg": "npm run build && npm run strip-premium:wporg && npm --prefix dist-wporg run build-admin && npm run make-pot:wporg && npm run clean-dist:wporg && npm run zip:wporg",
        "build:zip": "npm run build && npm run make-pot && wp-scripts plugin-zip",
        "build:tokens": "node scripts/build-tokens.js"
    },
    "keywords": [
        "wordpress",
        "accessibility",
        "wcag",
        "a11y",
        "widget"
    ],
    "author": "Plugininja",
    "license": "GPL-2.0-or-later",
    "devDependencies": {
        "@wordpress/element": "^6.23.0",
        "@wordpress/i18n": "^5.6.0",
        "@wordpress/scripts": "^31.4.0",
        "autoprefixer": "^10.4.21",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "^13.0.0",
        "cssnano": "^7.0.7",
        "glob": "^11.0.2",
        "postcss": "^8.5.3",
        "postcss-cli": "^11.0.1",
        "postcss-preset-env": "^10.4.0",
        "sass": "^1.77.8",
        "typescript": "^5.6.3",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.12.0",
        "clsx": "^2.1.1",
        "framer-motion": "^12.20.4",
        "material-symbols": "^0.33.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.6.1"
    }
}