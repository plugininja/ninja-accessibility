{
    "name": "ninja-accessibility",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "WordPress accessibility plugin — Ninja Accessibility",
    "files": [
        "app",
        "assets",
        "core",
        "includes",
        "languages",
        "templates",
        "index.php",
        "ninja-accessibility.php",
        "readme.txt",
        "uninstall.php"
    ],
    "scripts": {
        "build:tokens": "node scripts/build-tokens.js",
        "dev-admin": "webpack serve --config webpack.dev.config.js",
        "build-admin": "webpack --config webpack.prod.config.js",
        "watch-assets": "npm run build:tokens && wp-scripts start --config webpack.dev.config.js",
        "watch-sass": "node scripts/watch-css.js",
        "buildSass": "npm run build:tokens && sass source/assets/sass:assets/css --style=compressed --no-source-map --load-path=node_modules --silence-deprecation=import",
        "buildPostcss": "postcss \"assets/css/*.css\" \"assets/css/**/*.css\" --replace --no-map",
        "start": "concurrently \"npm:watch-*\"",
        "dev-hot": "concurrently \"npm:watch-sass\" \"npm:dev-admin\" ",
        "clean-maps": "find . \\( -name \"*.map\" -o -name \".DS_Store\" \\) -type f -delete",
        "plugin:zip": "wp-scripts plugin-zip",
        "lint": "eslint source/ --ext .js,.jsx,.ts,.tsx",
        "lint:fix": "eslint source/ --ext .js,.jsx,.ts,.tsx --fix",
        "build": "npm run buildSass && npm run buildPostcss && concurrently \"npm:build-*\" && npm run clean-maps",
        "make-pot": "wp i18n make-pot . languages/ninja-accessibility.pot --exclude=assets,freemius,node_modules,source --domain=ninja-accessibility --slug=ninja-accessibility --package-name=\"Ninja Accessibility\" --headers='{\"Report-Msgid-Bugs-To\":\"https://wordpress.org/support/plugin/ninja-accessibility\"}'",
        "build:zip": "npm run build && npm run make-pot && npm run plugin:zip",
        "buildSass:free": "npm run build:tokens && sass source/assets/sass:assets/css --style=expanded --load-path=node_modules --silence-deprecation=import",
        "buildPostcss:free": "postcss \"assets/css/*.css\" \"assets/css/**/*.css\" --replace --no-map",
        "build-admin:dev": "webpack --config webpack.prod.config.js --no-optimization-minimize --devtool source-map"
    },
    "keywords": [
        "wordpress",
        "accessibility",
        "wcag",
        "a11y",
        "widget"
    ],
    "author": "Plugininja",
    "license": "GPL-2.0-or-later",
    "devDependencies": {
        "@wordpress/element": "^6.23.0",
        "@wordpress/i18n": "^5.6.0",
        "@wordpress/scripts": "^31.4.0",
        "autoprefixer": "^10.4.21",
        "concurrently": "^8.2.2",
        "copy-webpack-plugin": "^13.0.0",
        "cssnano": "^7.0.7",
        "glob": "^11.0.2",
        "postcss": "^8.5.3",
        "postcss-cli": "^11.0.1",
        "postcss-preset-env": "^10.4.0",
        "sass": "^1.77.8",
        "typescript": "^5.6.3",
        "webpack-cli": "^6.0.1"
    },
    "dependencies": {
        "@reduxjs/toolkit": "^2.12.0",
        "clsx": "^2.1.1",
        "framer-motion": "^12.20.4",
        "material-symbols": "^0.33.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.6.1"
    }
}